# Ejemplo de configuración de variables de entorno
# Copia este archivo como .env y completa con tus credenciales de Blizzard

# Título de la aplicación
VUE_APP_TITLE=DIABLO_3

# Credenciales de OAuth de Blizzard Battle.net
# Obtén estas credenciales en: https://develop.battle.net/
VUE_APP_CLIENT_ID=tu_client_id_aqui
VUE_APP_CLIENT_SECRET=tu_client_secret_aqui

# Notas importantes:
# - Estas credenciales son privadas y no deben ser compartidas
# - El CLIENT_SECRET no debe exponerse en el código del frontend
# - Registra tu aplicación en https://develop.battle.net/ para obtener las credenciales